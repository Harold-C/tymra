{
  "name": "@tymra/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "api": "tsx src/api.ts",
    "scheduler": "tsx src/scheduler.ts",
    "cli": "tsx src/cli.ts",
    "accept:public": "tsx src/accept-public-sources.ts",
    "soak:eventfinda": "tsx src/soak-eventfinda.ts",
    "soak:nz-public-signals": "tsx src/soak-nz-public-signals.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsup src/index.ts src/api.ts src/scheduler.ts src/cli.ts --format esm --platform node --target node22 --out-dir dist --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tymra/config": "workspace:*",
    "@tymra/db": "workspace:*",
    "@tymra/domain": "workspace:*",
    "@tymra/providers": "workspace:*",
    "@tymra/queue": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3"
  }
}
