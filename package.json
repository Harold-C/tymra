{
  "name": "nbc-tymra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.9.0 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "worker": "pnpm --filter @tymra/worker dev",
    "db:generate": "pnpm --filter @tymra/db db:generate",
    "db:migrate": "pnpm --filter @tymra/db db:migrate",
    "db:seed": "pnpm --filter @tymra/db db:seed",
    "build": "NODE_ENV=production NEXT_DIST_DIR=.next-build next build && pnpm --filter @tymra/worker build",
    "lint": "next lint && pnpm -r --if-present lint",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run --config vitest.config.ts && pnpm --filter @tymra/worker test && pnpm --filter @tymra/browser-runtime test && pnpm --filter @tymra/browser-site-extractors test && pnpm --filter @tymra/browser-worker test",
    "test:integration": "DATABASE_URL=${DATABASE_URL:-postgresql://tymra@127.0.0.1:5433/tymra_dev} vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@tymra/config": "workspace:*",
    "@tymra/db": "workspace:*",
    "@tymra/domain": "workspace:*",
    "@tymra/providers": "workspace:*",
    "@tymra/queue": "workspace:*",
    "@tymra/ui": "workspace:*",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.12",
    "lucide-react": "^0.468.0",
    "next": "^14.2.4",
    "next-intl": "^3.26.5",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.61.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
