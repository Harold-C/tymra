{
  "name": "nbc-tymra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.9.0 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "cli": "tsx --env-file=.env apps/worker/src/cli.ts",
    "compose:up": "docker compose build web && docker compose up -d",
    "compose:down": "docker compose down --remove-orphans",
    "compose:scheduler:up": "SCHEDULER_ENABLED=true docker compose --profile scheduler up -d scheduler",
    "compose:scheduler:down": "docker compose --profile scheduler rm --stop --force scheduler",
    "compose:smoke": "./scripts/verify-compose-smoke.sh",
    "dev": "pnpm --filter @tymra/web dev",
    "worker": "pnpm --filter @tymra/worker dev",
    "accept:public": "pnpm --filter @tymra/worker accept:public",
    "accept:soak:eventfinda": "pnpm --filter @tymra/worker soak:eventfinda",
    "accept:soak:ota": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs apps/worker/src/soak-ota-argus.ts",
    "db:generate": "pnpm --filter @tymra/db db:generate",
    "db:migrate": "pnpm --filter @tymra/db db:migrate",
    "db:seed": "pnpm --filter @tymra/db db:seed",
    "build": "pnpm --filter @tymra/web build && pnpm --filter @tymra/worker build",
    "lint": "cd apps/web && node scripts/lint.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --config vitest.config.ts && pnpm --filter @tymra/worker test",
    "test:integration": "DATABASE_URL=${DATABASE_URL:-postgresql://tymra@127.0.0.1:5433/tymra_dev} vitest run --config vitest.integration.config.ts",
    "test:e2e": "PROVIDER_MODE=demo playwright test --project=desktop && PROVIDER_MODE=demo playwright test --project=mobile",
    "test:e2e:member-matrix": "node --env-file=.env node_modules/playwright/cli.js test --config=playwright.member-matrix.config.ts",
    "test:e2e:member-live": "MEMBER_LIVE_E2E=1 playwright test --config=playwright.member-live.config.ts",
    "test:stripe:readiness": "tsx --env-file=.env scripts/verify-stripe-test-readiness.ts",
    "test:e2e:stripe": "STRIPE_TEST_E2E=1 node --env-file=.env node_modules/playwright/cli.js test --config=playwright.stripe-test.config.ts",
    "test:challenge:readiness": "tsx --env-file=.env scripts/verify-managed-challenge-readiness.ts",
    "test:challenge:controlled": "tsx scripts/verify-managed-challenge-controlled.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@tymra/db": "workspace:*",
    "@types/node": "^20.14.10",
    "bcryptjs": "^3.0.2",
    "playwright": "^1.61.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  }
}
