}

model ContactRequest {
  id             String   @id @default(cuid())
  name           String
  emailHash      String
  encryptedEmail String
  topic          String
  message        String
  checkId        String?
  locale         String
  referenceId    String   @unique
  createdAt      DateTime @default(now())
}

model Job {
  id                 String                 @id @default(cuid())
  type               JobType
  status             JobStatus              @default(PENDING)
  payload            Json
  idempotencyKey     String                 @unique
  priceCheckId       String?
  analysisRequestId  String?
  queueName          String                 @default("default")
  correlationId      String?
  collectionRunId    String?
  sourceId           String?
  listingId          String?
  sellableUnitId     String?
  querySignatureHash String?
  snapshotId         String?
  resultVersionId    String?
  priority           Int                    @default(100)
  attemptCount       Int                    @default(0)
  maxAttempts        Int                    @default(3)
  runAt              DateTime               @default(now())
  lockedAt           DateTime?
  lockedBy           String?
  leaseExpiresAt     DateTime?
  lastErrorCode      String?
  lastErrorMessage   String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  completedAt        DateTime?
  priceCheck         PriceCheck?            @relation(fields: [priceCheckId], references: [id])
  analysisRequest    WorkerAnalysisRequest? @relation(fields: [analysisRequestId], references: [id])
  collectionRuns     CollectionRun[]

  @@index([status, runAt, priority])
  @@index([queueName, status, runAt, priority])
  @@index([analysisRequestId, createdAt])
  @@index([leaseExpiresAt])
}

model ArgusExecution {
  id                String               @id @default(cuid())
  orchestrationKey  String               @unique
  parentJobId       String
  collectionRunId   String
  dataSourceId      String
  argusJobId        String               @unique
  traceId           String
  connectorId       String
  workflowId        String
  requestedUrl      String
  status            ArgusExecutionStatus @default(SUBMITTED)
  result            Json?
  errorCategory     String?
  errorMessage      String?
  retryable         Boolean?
  submittedAt       DateTime             @default(now())
  lastPolledAt      DateTime?
  deadlineAt        DateTime
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([parentJobId, status])
  @@index([collectionRunId, createdAt])
  @@index([status, deadlineAt])
}

model EmailDelivery {
  id                 String                 @id @default(cuid())
  priceCheckId       String?
  analysisRequestId  String?
  resultVersionId    String?
  type               EmailType
  locale             String
  recipientHash      String
  encryptedRecipient String
  provider           String
  status             DeliveryStatus         @default(PENDING)
  idempotencyKey     String                 @unique
  attemptCount       Int                    @default(0)
  lastError          String?
  queuedAt           DateTime               @default(now())
  sentAt             DateTime?
  createdAt          DateTime               @default(now())
  priceCheck         PriceCheck?            @relation(fields: [priceCheckId], references: [id])
  analysisRequest    WorkerAnalysisRequest? @relation(fields: [analysisRequestId], references: [id])
  resultVersion      ResultVersion?         @relation(fields: [resultVersionId], references: [id])

  @@index([status, queuedAt])
  @@index([analysisRequestId, queuedAt])
}

model ManualImport {
  id             String       @id @default(cuid())
  dataSourceId   String
  status         ImportStatus @default(UPLOADED)
  format         String
  filename       String
  collectedAt    DateTime
  rightsMetadata Json
  rowCount       Int          @default(0)
  validRowCount  Int          @default(0)
  errorRowCount  Int          @default(0)
  errors         Json
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  importedAt     DateTime?
  dataSource     DataSource   @relation(fields: [dataSourceId], references: [id])

  @@index([dataSourceId, createdAt])
}
