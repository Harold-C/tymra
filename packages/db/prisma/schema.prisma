generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PriceCheckStatus {
  DRAFT
  VALIDATING
  NEEDS_CONFIRMATION
  QUEUED
  COLLECTING
  NORMALIZING
  ANALYSING
  AUTO_VALIDATING
  EXCEPTION
  READY
  PUBLISHED
  PARTIAL
  INSUFFICIENT_DATA
  UNSUPPORTED
  SOURCE_UNAVAILABLE
  FAILED
  CANCELLED
  EXPIRED
  WITHDRAWN
  ARCHIVED
}

enum MarketStatus {
  SUPPORTED
  PILOT_AVAILABLE
  COMING_SOON
  INSUFFICIENT_MARKET_DATA
  DISABLED
}

enum DataSourceStatus {
  APPROVED
  PILOT
  SUSPENDED
  DISABLED
  DEPRECATED
  UNKNOWN
}

enum SourceHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum ProviderType {
  DEMO
  MANUAL
  OTA
  PUBLIC
  FIXTURE
}

enum SourceType {
  OTA
  META_SEARCH
  PUBLIC_DATA
  MANUAL_IMPORT
  FIXTURE
}

enum SourceLifecycle {
  RESEARCH
  POC
  PILOT
  PRODUCTION
  SUSPENDED
  BLOCKED
}

enum InternalApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LegalRightsStatus {
  ALLOWED
  REVIEW
  BLOCKED
}

enum OperationalStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNCONFIGURED
  BLOCKED
}

enum SourceEnvironment {
  DEVELOPMENT
  TEST
  PILOT
  PRODUCTION
}

enum CacheHitType {
  EXACT_FRESH
  PARTIAL
  STALE
  MISS
  NEGATIVE
  CONFLICT
}

enum AvailabilityCohortStatus {
  AVAILABLE
  RESTRICTED
  UNAVAILABLE
  DATA_MISSING
  SOURCE_FAILURE
}

enum SnapshotStatus {
  BUILDING
  READY
  PARTIAL
  BLOCKED
  SUPERSEDED
}

enum QualityGateResult {
  PASSED
  PASSED_WITH_LIMITATIONS
  BLOCKED
}

enum PanelMembershipType {
  ANCHOR
  ROTATING
}

enum RelationshipType {
  CORE
  EXTENDED
  EXCLUDED
}

enum WorkerAnalysisStatus {
  RECEIVED
  RESOLVING_INPUT
  NEEDS_CONFIRMATION
  QUEUED
  CHECKING_CACHE
  COLLECTING_TARGET
  COLLECTING_COMPETITORS
  COLLECTING_MARKET_SIGNALS
  NORMALISING
  VALIDATING
  BUILDING_SNAPSHOT
  ANALYSING
  PARTIAL
  INSUFFICIENT_DATA
  SOURCE_UNAVAILABLE
  COMPLETED
  FAILED
  CANCELLED
}

enum CompetitorRole {
  CORE
  REFERENCE
  EXCLUDED
}

enum FeeCompleteness {
  COMPLETE
  PARTIAL
  UNKNOWN
}

enum AvailabilityStatus {
  AVAILABLE
  SOLD_OUT
  CLOSED_TO_ARRIVAL
  MINIMUM_STAY_RESTRICTION
  LISTING_UNAVAILABLE
  DATA_UNAVAILABLE
  PLATFORM_ERROR
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

enum RiskLevel {
  NO_CLEAR_RISK
  WATCH
  REVIEW
  HIGH_PRIORITY
}

enum ExceptionType {
  PROPERTY_MATCH
  UNIT_MATCH
  COMPETITOR_RELATIONSHIP
  FEE_COMPLETENESS
  RATE_OUTLIER
  SOURCE_CONFLICT
  SOURCE_FAILURE
  HIGH_PRIORITY_REVIEW
  RESULT_SCHEMA
  USER_REPORT
}

enum ExceptionPriority {
  P0
  P1
  P2
  P3
}

enum ExceptionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum CollectionMode {
  ON_DEMAND
  MARKET_COVERAGE
}

enum CollectionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum JobType {
  ARGUS_JOB_POLL
  INPUT_RESOLUTION
  LISTING_RESOLUTION
  PROPERTY_IDENTIFICATION
  UNIT_IDENTIFICATION
  CATALOG_DISCOVERY
  RATE_COLLECTION
  AVAILABILITY_COLLECTION
  POLICY_COLLECTION
  PUBLIC_DATA_COLLECTION
  EVENT_COLLECTION
  WEATHER_COLLECTION
  TRANSPORT_COLLECTION
  RATE_NORMALIZATION
  COMPETITOR_BUILD
  SNAPSHOT_GENERATION
  PRICE_ANALYSIS
  ANALYSIS
  AUTO_VALIDATION
  RESULT_GENERATION
  RESULT_PUBLICATION
  EMAIL_DELIVERY
  RESULT_NOTIFICATION
  LINK_EXPIRY
  MARKET_COVERAGE_COLLECTION
  ANCHOR_PANEL_COLLECTION
  ROTATING_PANEL_COLLECTION
  SOURCE_HEALTH_CHECK
  RETENTION_CLEANUP
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum ArgusExecutionStatus {
  SUBMITTED
  RUNNING
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum ResultVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum FeedbackType {
  COMPETITORS_RELEVANT
  COMPETITORS_NOT_RELEVANT
  INSIGHT_USEFUL
  REVIEWED_PRICE
  CHANGED_PRICE
  NO_ACTION_NEEDED
  REPORT_ISSUE
}

enum EmailType {
  VERIFY_AND_SIGN_IN
  CHECK_RECEIVED
  CONFIRMATION_REQUIRED
  CHECK_PROCESSING
  RESULT_READY
  PARTIAL_RESULT
  INSUFFICIENT_DATA
  CHECK_FAILED
  LINK_REISSUED
}

enum AnonymousCheckStatus {
  CREATED
  VALIDATING_LISTING
  CAPTURING_CONTEXT
  ROUGH_ANALYSING
  ROUGH_READY
  INVALID_INPUT
  UNSUPPORTED
  NO_DEFAULT_QUOTE
  INSUFFICIENT
  FAILED
  EXPIRED
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
  BLOCKED
}

enum AbuseOutcome {
  ALLOW
  CHALLENGE
  COOLDOWN
  REJECT
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum MarketSignalType {
  PUBLIC_HOLIDAY
  ANNIVERSARY_DAY
  SCHOOL_HOLIDAY
  MAJOR_EVENT
  WEEKEND_PATTERN
  PRICE_RISING
  AVAILABILITY_TIGHTENING
  RESTRICTION_INCREASING
  WEATHER_OR_ACCESS_DISRUPTION
  TOURISM_DEMAND
  TRANSPORT_FLOW
  FX_RATE
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  IMPORTED
  PARTIAL
  REJECTED
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditEvents  AuditEvent[]
  merges       IdentityMerge[]
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model CustomerUser {
  id               String            @id @default(cuid())
  emailHash        String            @unique
  encryptedEmail   String
  locale           String
  status           CustomerStatus    @default(ACTIVE)
  marketingConsent Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         CustomerSession[]
  magicLinks       MagicLink[]
  anonymousChecks  AnonymousCheck[]
  priceChecks      PriceCheck[]

  @@index([status, createdAt])
}

model CustomerSession {
  id             String       @id @default(cuid())
  customerUserId String
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([customerUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AnonymousCheck {
  id             String               @id @default(cuid())
  locale         String
  platform       String
  listingId      String
  cacheKey       String
  idempotencyKey String               @unique
  status         AnonymousCheckStatus @default(CREATED)
  pricingContext Json
  failureReason  String?
  propertyId     String?
  unitId         String?
  customerUserId String?
  isDemo         Boolean              @default(false)
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  property       Property?            @relation(fields: [propertyId], references: [id])
  unit           SellableUnit?        @relation(fields: [unitId], references: [id])
  customerUser   CustomerUser?        @relation(fields: [customerUserId], references: [id])
  roughResult    RoughResult?
  magicLinks     MagicLink[]
  priceChecks    PriceCheck[]

  @@index([cacheKey, status, createdAt])
  @@index([customerUserId, createdAt])
  @@index([expiresAt])
}

model RoughResult {
  id                  String          @id @default(cuid())
  anonymousCheckId    String          @unique
  propertyName        String
  locality            String
  unitName            String
  pricePosition       String
  estimatedGapLowPct  Int?
  estimatedGapHighPct Int?
  observedPriceMinor  Int?
  marketLowMinor      Int?
  marketHighMinor     Int?
  currency            String          @default("NZD")
  confidence          ConfidenceLevel
  sourceLabel         String
  capturedAt          DateTime
  limitations         Json
  isDemo              Boolean         @default(false)
  createdAt           DateTime        @default(now())
  anonymousCheck      AnonymousCheck  @relation(fields: [anonymousCheckId], references: [id], onDelete: Cascade)
}

model MagicLink {
  id               String             @id @default(cuid())
  tokenHash        String             @unique
  idempotencyKey   String             @unique
  purpose          String             @default("VERIFY_AND_SIGN_IN")
  status           VerificationStatus @default(PENDING)
  emailHash        String
  encryptedEmail   String
  locale           String
  anonymousCheckId String
  customerUserId   String?
  marketingConsent Boolean            @default(false)
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  anonymousCheck   AnonymousCheck     @relation(fields: [anonymousCheckId], references: [id], onDelete: Cascade)
  customerUser     CustomerUser?      @relation(fields: [customerUserId], references: [id])

  @@index([emailHash, createdAt])
  @@index([anonymousCheckId, status])
  @@index([expiresAt, status])
}

model UsageLedger {
  id               String   @id @default(cuid())
  action           String
  subjectType      String
  subjectHash      String
  anonymousCheckId String?
  customerUserId   String?
  metadata         Json
  createdAt        DateTime @default(now())

  @@index([action, subjectType, subjectHash, createdAt])
  @@index([customerUserId, action, createdAt])
}

model AbuseDecision {
  id               String       @id @default(cuid())
  action           String
  subjectHash      String
  outcome          AbuseOutcome
  reasonCodes      Json
  anonymousCheckId String?
  cooldownUntil    DateTime?
  createdAt        DateTime     @default(now())

  @@index([action, subjectHash, createdAt])
  @@index([cooldownUntil])
}

model Property {
  id                   String                  @id @default(cuid())
  canonicalName        String
  legalOrBrandName     String?
  address              String
  city                 String
  countryCode          String                  @default("NZ")
  latitude             Float?
  longitude            Float?
  region               String?
  territorialAuthority String?
  rto                  String?
  postcode             String?
  microMarket          String?
  timezone             String                  @default("Pacific/Auckland")
  accommodationType    String
  supportStatus        MarketStatus            @default(COMING_SOON)
  identityConfidence   Float                   @default(0)
  status               String                  @default("ACTIVE")
  mergedIntoId         String?
  isDemo               Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  mergedInto           Property?               @relation("PropertyMerge", fields: [mergedIntoId], references: [id])
  mergedProperties     Property[]              @relation("PropertyMerge")
  units                SellableUnit[]
  priceChecks          PriceCheck[]
  anonymousChecks      AnonymousCheck[]
  listings             Listing[]
  observations         RateObservation[]
  workerAnalyses       WorkerAnalysisRequest[]

  @@index([countryCode, city])
  @@index([canonicalName])
}

model SellableUnit {
  id                      String                   @id @default(cuid())
  propertyId              String
  canonicalName           String
  officialName            String
  capacity                Int
  bedrooms                Int?
  bathrooms               Float?
  bedTypes                Json
  bedConfiguration        Json?
  amenities               Json
  accessibilityAttributes Json?
  unitType                String
  entireOrShared          String?
  status                  String                   @default("ACTIVE")
  version                 Int                      @default(1)
  mergedIntoId            String?
  isDemo                  Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  property                Property                 @relation(fields: [propertyId], references: [id])
  mergedInto              SellableUnit?            @relation("UnitMerge", fields: [mergedIntoId], references: [id])
  mergedUnits             SellableUnit[]           @relation("UnitMerge")
  listings                Listing[]
  targetRelationships     CompetitorRelationship[] @relation("TargetUnit")
  competitorRelationships CompetitorRelationship[] @relation("CompetitorUnit")
  priceChecks             PriceCheck[]
  anonymousChecks         AnonymousCheck[]
  observations            RateObservation[]
  collectionProfiles      CollectionProfile[]
  panelMemberships        PanelMembership[]
  workerAnalyses          WorkerAnalysisRequest[]
  competitorSetTargets    CompetitorSetVersion[]   @relation("CompetitorSetTarget")
  competitorMembers       CompetitorSetMember[]    @relation("CompetitorSetMemberUnit")

  @@index([propertyId, status])
}

model Listing {
  id                String                  @id @default(cuid())
  propertyId        String
  unitId            String
  dataSourceId      String
  platform          String
  externalId        String
  sourceListingId   String
  canonicalUrl      String
  rawUrl            String
  url               String
  platformUnitName  String
  firstDiscoveredAt DateTime                @default(now())
  lastConfirmedAt   DateTime?
  onlineStatus      String                  @default("UNKNOWN")
  listingStatus     String                  @default("UNKNOWN")
  matchConfidence   Float                   @default(0)
  legalRightsStatus LegalRightsStatus       @default(REVIEW)
  operationalStatus OperationalStatus       @default(UNCONFIGURED)
  metadata          Json                    @default("{}")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isDemo            Boolean                 @default(false)
  property          Property                @relation(fields: [propertyId], references: [id])
  unit              SellableUnit            @relation(fields: [unitId], references: [id])
  dataSource        DataSource              @relation(fields: [dataSourceId], references: [id])
  observations      RateObservation[]
  workerAnalyses    WorkerAnalysisRequest[]

  @@unique([dataSourceId, externalId])
  @@index([unitId, onlineStatus])
}

model StayQuery {
  id                    String            @id @default(cuid())
  checkIn               DateTime
  checkOut              DateTime
  nights                Int
  adults                Int               @default(2)
  children              Int               @default(0)
  childrenAges          Json              @default("[]")
  units                 Int               @default(1)
  unitConstraints       Json              @default("{}")
  mealPlan              String            @default("ANY_PUBLIC")
  currency              String            @default("NZD")
  cancellationCategory  String
  cancellationPolicy    String            @default("ANY_PUBLIC")
  ratePlan              String            @default("PUBLIC")
  taxAndFeePolicy       String            @default("MANDATORY_INCLUDED")
  publicRateContext     String            @default("PUBLIC_ANONYMOUS")
  querySemanticsVersion String            @default("v1")
  querySignatureHash    String?
  timezone              String
  reason                String?
  createdAt             DateTime          @default(now())
  priceChecks           PriceCheck[]
  observations          RateObservation[]
  queryPlans            QueryPlan[]
}

model QueryPlan {
  id                      String                 @id @default(cuid())
  priceCheckId            String?
  analysisRequestId       String?
  stayQueryId             String
  dataSourceId            String?
  version                 Int                    @default(1)
  dateBasket              Json
  querySignatureHash      String
  querySignaturePayload   Json
  collectionProfileKey    String
  generationPolicyVersion String                 @default("query-plan-v1")
  freshnessPolicyVersion  String                 @default("freshness-v1")
  createdAt               DateTime               @default(now())
  priceCheck              PriceCheck?            @relation(fields: [priceCheckId], references: [id])
  analysisRequest         WorkerAnalysisRequest? @relation(fields: [analysisRequestId], references: [id])
  stayQuery               StayQuery              @relation(fields: [stayQueryId], references: [id])
  dataSource              DataSource?            @relation(fields: [dataSourceId], references: [id])
  marketSnapshots         MarketSnapshot[]

  @@unique([analysisRequestId, version])
  @@index([querySignatureHash, createdAt])
  @@index([priceCheckId, version])
}

model CollectionProfile {
  id                    String            @id @default(cuid())
  key                   String            @unique
  sellableUnitId        String?
  dataSourceId          String?
  ipRegion              String
  locale                String
  currency              String            @default("NZD")
  deviceType            String
  loggedInState         String
  memberState           String
  mobilePriceContext    String
  publicRateContext     String
  browserProfileVersion String
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sellableUnit          SellableUnit?     @relation(fields: [sellableUnitId], references: [id])
  dataSource            DataSource?       @relation(fields: [dataSourceId], references: [id])
  observations          RateObservation[]
  collectionRuns        CollectionRun[]

  @@index([dataSourceId, publicRateContext])
}

model WorkerAnalysisRequest {
  id                     String                 @id @default(cuid())
  rawInput               String
  inputType              String
  locale                 String                 @default("en")
  emailHash              String?
  encryptedEmail         String?
  priceCheckId           String?                @unique
  serviceConsent         Boolean                @default(false)
  marketingConsent       Boolean                @default(false)
  propertyId             String?
  sellableUnitId         String?
  targetListingId        String?
  dataSourceId           String?
  status                 WorkerAnalysisStatus   @default(RECEIVED)
  idempotencyKey         String                 @unique
  correlationId          String                 @unique
  cacheHitType           CacheHitType           @default(MISS)
  confirmationCandidates Json                   @default("[]")
  failureCode            String?
  failureMessage         String?
  isPreview              Boolean                @default(true)
  isFixture              Boolean                @default(false)
  cancelledAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  property               Property?              @relation(fields: [propertyId], references: [id])
  sellableUnit           SellableUnit?          @relation(fields: [sellableUnitId], references: [id])
  targetListing          Listing?               @relation(fields: [targetListingId], references: [id])
  dataSource             DataSource?            @relation(fields: [dataSourceId], references: [id])
  priceCheck             PriceCheck?            @relation(fields: [priceCheckId], references: [id])
  queryPlans             QueryPlan[]
  collectionRuns         CollectionRun[]
  competitorSets         CompetitorSetVersion[]
  marketSnapshots        MarketSnapshot[]
  dateSnapshots          DateSnapshot[]
  priceAnalyses          PriceAnalysis[]
  resultVersions         ResultVersion[]
  jobs                   Job[]
  emails                 EmailDelivery[]

  @@index([status, createdAt])
  @@index([sellableUnitId, createdAt])
  @@index([emailHash, status])
}

model CompetitorSetVersion {
  id                   String                @id @default(cuid())
  analysisRequestId    String
  targetSellableUnitId String
  version              Int
  algorithmVersion     String
  marketScope          Json
  expansionLevel       Int                   @default(0)
  createdBy            String
  effectiveFrom        DateTime              @default(now())
  effectiveTo          DateTime?
  createdAt            DateTime              @default(now())
  analysisRequest      WorkerAnalysisRequest @relation(fields: [analysisRequestId], references: [id])
  targetSellableUnit   SellableUnit          @relation("CompetitorSetTarget", fields: [targetSellableUnitId], references: [id])
  members              CompetitorSetMember[]
  marketSnapshots      MarketSnapshot[]

  @@unique([analysisRequestId, version])
  @@index([targetSellableUnitId, effectiveTo])
}

model CompetitorSetMember {
  id                       String               @id @default(cuid())
  competitorSetVersionId   String
  competitorSellableUnitId String
  relationshipType         RelationshipType
  comparabilityScore       Float
  geographyScore           Float
  propertyTypeScore        Float
  unitScore                Float
  qualityScore             Float
  priceTierScore           Float
  inclusionReason          String?
  exclusionReason          String?
  effectiveFrom            DateTime             @default(now())
  effectiveTo              DateTime?
  createdBy                String
  algorithmVersion         String
  competitorSetVersion     CompetitorSetVersion @relation(fields: [competitorSetVersionId], references: [id], onDelete: Cascade)
  competitorSellableUnit   SellableUnit         @relation("CompetitorSetMemberUnit", fields: [competitorSellableUnitId], references: [id])

  @@unique([competitorSetVersionId, competitorSellableUnitId])
  @@index([competitorSellableUnitId, effectiveTo])
}

model DateSnapshot {
  id                        String                @id @default(cuid())
  analysisRequestId         String
  marketSnapshotId          String?
  stayDate                  DateTime
  targetRateMinor           Int?
  validCompetitorCount      Int
  availableCount            Int
  restrictedCount           Int
  unavailableCount          Int
  dataMissingCount          Int
  sourceFailureCount        Int
  marketMedianMinor         Int?
  lowerQuartileMinor        Int?
  upperQuartileMinor        Int?
  availabilityCompression   Float?
  eventImpact               Float?
  eventEvidence             Json                  @default("{}")
  disruptionImpact          Json
  newestObservationAt       DateTime?
  oldestObservationAt       DateTime?
  maxObservationSkewMinutes Int?
  freshness                 Json
  qualityGateResult         QualityGateResult
  qualityFlags              Json
  confidenceScore           Float
  confidenceLevel           ConfidenceLevel
  observationIds            Json
  snapshotVersion           String
  createdAt                 DateTime              @default(now())
  analysisRequest           WorkerAnalysisRequest @relation(fields: [analysisRequestId], references: [id])
  marketSnapshot            MarketSnapshot?       @relation(fields: [marketSnapshotId], references: [id])

  @@unique([analysisRequestId, stayDate, snapshotVersion])
  @@index([stayDate, createdAt])
}

model MarketSnapshot {
  id                        String                @id @default(cuid())
  analysisRequestId         String
  priceCheckId              String?
  targetPropertyId          String
  targetSellableUnitId      String
  targetListingId           String
  queryPlanId               String
  queryPlanVersion          Int
  competitorSetVersionId    String
  asOf                      DateTime
  marketScope               Json
  observationIds            Json
  sourceRegistryVersions    Json
  collectionProfileVersions Json
  newestObservationAt       DateTime?
  oldestObservationAt       DateTime?
  maxObservationSkewMinutes Int?
  sourceCoverage            Float
  competitorCoverage        Float
  missingRate               Float
  conflicts                 Json
  exclusionReasons          Json
  qualityGateResult         QualityGateResult
  qualityFlags              Json
  snapshotVersion           String
  generationPolicyVersion   String
  freshnessPolicyVersion    String
  qualityGateVersion        String
  contentHash               String                @unique
  status                    SnapshotStatus
  createdAt                 DateTime              @default(now())
  analysisRequest           WorkerAnalysisRequest @relation(fields: [analysisRequestId], references: [id])
  priceCheck                PriceCheck?           @relation(fields: [priceCheckId], references: [id])
  queryPlan                 QueryPlan             @relation(fields: [queryPlanId], references: [id])
  competitorSetVersion      CompetitorSetVersion  @relation(fields: [competitorSetVersionId], references: [id])
  dateSnapshots             DateSnapshot[]
  priceAnalyses             PriceAnalysis[]
  resultVersions            ResultVersion[]

  @@index([analysisRequestId, asOf])
  @@index([targetSellableUnitId, asOf])
}

model PriceAnalysis {
  id                       String                @id @default(cuid())
  analysisRequestId        String
  marketSnapshotId         String
  marketMedianMinor        Int?
  weightedRange            Json
  percentile               Float?
  comparableCount          Int
  marketRateIndex          Float?
  availabilityCompression  Float?
  demandPressure           Float?
  eventImpact              Float?
  eventEvidence            Json                  @default("{}")
  accessibilityEffect      String
  demandDisplacementEffect String
  strandedTravellerEffect  String
  disruptionDirection      String
  marketReferenceRange     Json
  reviewRange              Json
  targetPricePosition      String
  keyDates                 Json
  reasonCodes              Json
  recommendedAction        String
  confidenceScore          Float
  confidenceComponents     Json
  dataGaps                 Json
  modelVersion             String
  ruleVersion              String
  createdAt                DateTime              @default(now())
  analysisRequest          WorkerAnalysisRequest @relation(fields: [analysisRequestId], references: [id])
  marketSnapshot           MarketSnapshot        @relation(fields: [marketSnapshotId], references: [id])

  @@index([analysisRequestId, createdAt])
}

model PanelMembership {
  id                String              @id @default(cuid())
  sellableUnitId    String
  marketKey         String
  membershipType    PanelMembershipType
  weight            Float               @default(1)
  replacementReason String?
  rotationDueAt     DateTime?
