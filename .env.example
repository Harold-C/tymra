# Runtime
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://tymra:replace-with-the-same-local-database-password@localhost:5433/tymra_dev
REDIS_URL=redis://localhost:6379
APP_BASE_URL=https://tymra.test
BASE_DOMAIN=tymra.test
PUBLIC_ORIGIN=https://tymra.test
ADMIN_ORIGIN=https://ops.tymra.test
WORKER_INTERNAL_URL=http://localhost:3100
ARGUS_API_BASE_URL=https://api.argus.test
ARGUS_API_TOKEN=replace-with-at-least-32-random-characters
ARGUS_TIMEOUT_MS=60000
ARGUS_JOB_POLL_TIMEOUT_MS=180000
MKCERT_ROOT_CA_PATH=/path/from-mkcert-CAROOT/rootCA.pem
ARGUS_EVIDENCE_ROOT=./data/argus-evidence
EVENTFINDA_MIN_DELAY_MS=4000
EVENTFINDA_DELAY_JITTER_MS=3000
EVENTFINDA_DAILY_REQUEST_BUDGET=2500
EVENTFINDA_DISCOVERY_MAX_PAGES=250
EVENTFINDA_DETAIL_BATCH_SIZE=80
TICKETMASTER_MIN_DELAY_MS=5000
TICKETMASTER_DELAY_JITTER_MS=4000
TICKETMASTER_DAILY_REQUEST_BUDGET=20
TICKETMASTER_DISCOVERY_MAX_PAGES=5
TICKETMASTER_DETAIL_BATCH_SIZE=3

# Generate unique values with at least 32 random bytes for every secret.
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@tymra.test
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
ADMIN_DEV_PASSWORD=
# Optional development-only shared password override. When blank, the password
# for demo1 through demo4 is derived from SESSION_SECRET.
MEMBER_DEV_PASSWORD=
RESULT_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACCESS_KEY_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-at-least-32-random-bytes

# Local product defaults
PROVIDER_MODE=demo
DEFAULT_MARKET=christchurch
AUTO_PUBLISH_ENABLED=true
ACCEPT_NEW_CHECKS=true
CUSTOMER_FUNNEL_ENABLED=true
BILLING_ENABLED=false
# Stripe Billing uses Checkout + Customer Portal. Enable only after webhook acceptance.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_HOST_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTFOLIO_PRICE_ID=
MEMBERSHIP_HOST_LAUNCH_ENABLED=false
MEMBERSHIP_PRO_LAUNCH_ENABLED=false
MEMBERSHIP_PORTFOLIO_LAUNCH_ENABLED=false
MEMBERSHIP_EXPORT_LAUNCH_ENABLED=false
MEMBERSHIP_API_LAUNCH_ENABLED=false
RESULT_LINK_TTL_DAYS=14
MAGIC_LINK_TTL_MINUTES=15
CUSTOMER_SESSION_TTL_DAYS=30
ROUGH_RESULT_CACHE_HOURS=6
ANONYMOUS_CHECK_RETENTION_DAYS=7
RESULT_NOTIFICATION_GRACE_SECONDS=120
WORKER_ID=tymra-worker-local
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=120
WORKER_API_HOST=0.0.0.0
WORKER_API_PORT=3100
SCHEDULER_ENABLED=false
HIGH_FREQUENCY_SCHEDULER_ENABLED=false
PUBLIC_COLLECTION_MODE=live
FIXTURE_COLLECTION_ENABLED=true
NEUTRAL_RESPONSE_MIN_MS=250
ABUSE_CHALLENGE_MODE=disabled
# Required only when ABUSE_CHALLENGE_MODE=managed
# ABUSE_CHALLENGE_VERIFY_URL=https://challenge-provider.example/verify
# ABUSE_CHALLENGE_SITE_KEY=
# ABUSE_CHALLENGE_SECRET=
RAW_ARTIFACT_TTL_HOURS=72
RAW_ARTIFACT_FAILURE_TTL_HOURS=168
FRESHNESS_CORE_HOURS=24
FRESHNESS_NEAR_TERM_SKEW_HOURS=2
FRESHNESS_LONG_TERM_SKEW_HOURS=6
PREVIEW_UNIT_24H_LIMIT=1
PREVIEW_DEVICE_UNITS_24H_LIMIT=3
PREVIEW_DEVICE_UNITS_30D_LIMIT=10
FORMAL_EMAIL_ACTIVE_LIMIT=1
FORMAL_UNIT_30D_LIMIT=1

# Docker Compose sends local service mail to Mailpit. Use log for redacted metadata only.
EMAIL_PROVIDER=smtp
COMPOSE_EMAIL_PROVIDER=smtp
EMAIL_FROM=Tymra by Synix <no-reply@tymra.test>
SMTP_URL=smtp://localhost:1025
COMPOSE_SMTP_URL=smtp://tymra-mailpit:1025

# Optional observability integrations
SENTRY_DSN=
ANALYTICS_ENDPOINT=
