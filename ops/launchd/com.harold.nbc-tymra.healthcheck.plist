<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.harold.nbc-tymra.healthcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/haroldchen/Library/Application Support/Tymra/ensure-local-dev.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
