{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./apps/web/*"
      ]
    }
  },
  "include": [
    "e2e/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "output"
  ]
}
